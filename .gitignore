# Root build artifacts
**/bin/
**/obj/
**/node_modules/
**/dist/
**/dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env / machine files
*.local
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln.docstates

# Environment files - never commit secrets
.env
.env.local
.env.*.local
# But DO commit the templates that don't contain secrets
!.env.development
!.env.production

# SQLite local database (development only - production uses Azure SQL)
api/*.db
api/*.db-journal

# Azure & deployment artifacts
*.PublishSettings
publish/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Images / misc temp files
image.png